{
  "name": "incremental-game-series",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "stage-1-token-office",
    "stage-2-signal-foundry"
  ],
  "scripts": {
    "dev:stage1": "npm run dev --workspace token-office",
    "dev:stage2": "npm run dev --workspace signal-foundry",
    "build:stage1": "npm run build --workspace token-office",
    "build:stage2": "npm run build --workspace signal-foundry -- --base=./",
    "build": "npm run build:stage1 && npm run build:stage2 && node scripts/assemble-dist.mjs"
  }
}
